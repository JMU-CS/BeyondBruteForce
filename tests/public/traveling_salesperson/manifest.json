{
  "version": 1,
  "checkpoint": 1,
  "problem": "traveling_salesperson",
  "algorithm": "exhaustive",
  "verifier_tests": [
    {
      "name": "cycle4_valid_tour",
      "instance": "instances/known_cycle4.txt",
      "tour": [
        0,
        1,
        2,
        3,
        0
      ],
      "expected": true,
      "k": 4
    },
    {
      "name": "cycle4_valid_tour_exceeds_k",
      "instance": "instances/known_cycle4.txt",
      "tour": [
        0,
        1,
        2,
        3,
        0
      ],
      "k": 3,
      "expected": false
    },
    {
      "name": "cycle4_rotated_valid_tour",
      "instance": "instances/known_cycle4.txt",
      "tour": [
        2,
        3,
        0,
        1,
        2
      ],
      "expected": true,
      "k": 4
    },
    {
      "name": "cycle4_missing_vertex",
      "instance": "instances/known_cycle4.txt",
      "tour": [
        0,
        1,
        2,
        0
      ],
      "expected": false,
      "k": 4
    },
    {
      "name": "cycle4_repeated_vertex",
      "instance": "instances/known_cycle4.txt",
      "tour": [
        0,
        1,
        2,
        1,
        0
      ],
      "expected": false,
      "k": 4
    },
    {
      "name": "cycle5_not_closed",
      "instance": "instances/known_cycle5.txt",
      "tour": [
        0,
        1,
        2,
        3,
        4,
        1
      ],
      "expected": false,
      "k": 100
    },
    {
      "name": "cycle5_out_of_range",
      "instance": "instances/known_cycle5.txt",
      "tour": [
        0,
        1,
        2,
        3,
        5,
        0
      ],
      "expected": false,
      "k": 100
    }
  ],
  "solver_tests": [
