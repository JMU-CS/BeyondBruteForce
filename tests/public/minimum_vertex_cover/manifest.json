      "vertices": [
        0
      ],
      "expected": false,
      "k": 1
    },
    {
      "name": "triangle_two_vertices_cover",
      "instance": "instances/known_triangle_all_optima.txt",
      "vertices": [
        0,
        2
      ],
      "expected": true,
      "k": 2
    },
    {
      "name": "triangle_one_vertex_not_cover",
      "instance": "instances/known_triangle_all_optima.txt",
      "vertices": [
        1
      ],
      "expected": false,
      "k": 1
    },
