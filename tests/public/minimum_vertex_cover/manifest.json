{
  "version": 1,
  "checkpoint": 2,
  "problem": "minimum_vertex_cover",
  "algorithm": "exhaustive",
  "verifier_tests": [
    {
      "name": "path3_middle_is_cover",
      "instance": "instances/known_path3_unique.txt",
      "vertices": [
        1
      ],
      "expected": true,
      "k": 1
    },
    {
      "name": "path3_middle_exceeds_k",
      "instance": "instances/known_path3_unique.txt",
      "vertices": [
        1
      ],
      "k": 0,
      "expected": false
    },
    {
      "name": "path3_endpoint_is_not_cover",
