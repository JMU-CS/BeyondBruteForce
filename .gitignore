# ============================================================
# Beyond Brute Force - repository ignore rules
# ============================================================

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging / build artifacts
build/
dist/
.eggs/
*.egg-info/
*.egg

# Coverage / profiling
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.prof

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating-system metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.out
*.err

# Jupyter
.ipynb_checkpoints/

# Machine-local experiment files.
# The README remains tracked so every clone contains the warning.
experiments/local/*
!experiments/local/README.md

# Optional public benchmark downloads. Keep the explanatory README files,
# but do not commit downloaded external benchmark data.
benchmarks/*/external/*
!benchmarks/*/external/README.md
